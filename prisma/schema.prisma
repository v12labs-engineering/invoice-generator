generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  accounts      Account[]
  sessions      Session[]
  memberships   Membership[]
  invitesSent   Invite[]    @relation("invitedBy")
  invoices      Invoice[]
  expenses      Expense[]
  bulkImports   BulkImport[]
  timeEntries   TimeEntry[]
  uploadedDocs  Document[]
  createdAt     DateTime  @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

enum MemberRole {
  OWNER
  MEMBER
}

model Business {
  id                String   @id @default(cuid())
  name              String
  addressLines      String[]
  email             String
  phone             String?
  logoUrl           String?
  taxId             String?
  bankDetails       String?
  defaultCurrency   String   @default("USD")
  defaultTaxRate    Int      @default(0)
  invoicePrefix     String   @default("INV-")
  nextInvoiceNumber Int      @default(1)
  defaultTemplate   InvoiceTemplate @default(CLASSIC)
  memberships       Membership[]
  invites           Invite[]
  clients           Client[]
  products          Product[]
  invoices          Invoice[]
  schedules         RecurringSchedule[]
  subscriptions     Subscription[]
  expenseCategories ExpenseCategory[]
  expenses          Expense[]
  bulkImports       BulkImport[]
  projects          Project[]
  timeEntries       TimeEntry[]
  contacts          Contact[]
  deals             Deal[]
  quotes            Quote[]
  employees         Employee[]
  timeOffRequests   TimeOffRequest[]
  documents         Document[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt
}

model Membership {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId String
  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  role       MemberRole @default(MEMBER)
  createdAt  DateTime   @default(now())
  @@unique([userId, businessId])
  @@index([businessId])
}

model Invite {
  id          String     @id @default(cuid())
  businessId  String
  business    Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  email       String
  role        MemberRole @default(MEMBER)
  invitedById String
  invitedBy   User       @relation("invitedBy", fields: [invitedById], references: [id])
  acceptedAt  DateTime?
  createdAt   DateTime   @default(now())
  @@unique([businessId, email])
  @@index([email])
}

model Client {
  id           String    @id @default(cuid())
  businessId   String
  business     Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name         String
  email        String?
  addressLines String[]
  taxId        String?
  notes        String?
  archivedAt   DateTime?
  invoices     Invoice[]
  schedules    RecurringSchedule[]
  projects     Project[]
  contacts     Contact[]
  deals        Deal[]
  quotes       Quote[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt
  @@index([businessId])
}

model Product {
  id             String   @id @default(cuid())
  businessId     String
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  unitPrice      Int
  currency       String
  defaultTaxRate Int      @default(0)
  archivedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
  @@index([businessId])
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIAL
  PAID
  VOID
}

enum InvoiceTemplate {
  CLASSIC
  MODERN
  MINIMAL
}

model Invoice {
  id                  String        @id @default(cuid())
  businessId          String
  business            Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdByUserId     String?
  createdByUser       User?         @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  number              String?
  clientId            String
  client              Client        @relation(fields: [clientId], references: [id])
  issueDate           DateTime
  dueDate             DateTime
  currency            String
  status              InvoiceStatus @default(DRAFT)
  subtotal            Int
  discountAmount      Int           @default(0)
  taxAmount           Int           @default(0)
  total               Int
  amountPaid          Int           @default(0)
  balance             Int
  notes               String?
  terms               String?
  template            InvoiceTemplate?
  pdfUrl              String?
  sentAt              DateTime?
  recurringScheduleId String?
  schedule            RecurringSchedule? @relation(fields: [recurringScheduleId], references: [id], onDelete: SetNull)
  lines               InvoiceLine[]
  payments            Payment[]
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @default(now()) @updatedAt
  @@unique([businessId, number])
  @@index([businessId, status])
  @@index([businessId, issueDate])
  @@index([businessId, clientId])
  @@index([businessId, status, dueDate])
}

model InvoiceLine {
  id           String  @id @default(cuid())
  invoiceId    String
  invoice      Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId    String?
  description  String
  quantity     Int
  unitPrice    Int
  lineDiscount Int     @default(0)
  taxRate      Int     @default(0)
  lineTotal    Int
  sortOrder    Int
  timeEntries  TimeEntry[]
  @@index([invoiceId])
}

model Payment {
  id        String   @id @default(cuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount    Int
  paidAt    DateTime
  method    String
  reference String?
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  @@index([invoiceId])
}

enum Cadence {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

model RecurringSchedule {
  id            String    @id @default(cuid())
  businessId    String
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  clientId      String
  client        Client    @relation(fields: [clientId], references: [id])
  templateJson  Json
  cadence       Cadence
  intervalCount Int       @default(1)
  startDate     DateTime
  endDate       DateTime?
  nextRunAt     DateTime
  lastRunAt     DateTime?
  autoSend      Boolean   @default(false)
  active        Boolean   @default(true)
  invoices      Invoice[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  @@index([businessId, active, nextRunAt])
}

model Subscription {
  id           String    @id @default(cuid())
  businessId   String
  business     Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name         String
  url          String?
  cost         Int?
  cycle        Cadence   @default(MONTHLY)
  startDate    DateTime  @default(now())
  nextRunAt    DateTime?
  lastRunAt    DateTime?
  active       Boolean   @default(true)
  notes        String?
  archivedAt   DateTime?
  expenses     Expense[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt
  @@unique([businessId, name])
  @@map("Vendor")
  @@index([businessId, active, nextRunAt])
  @@index([businessId, archivedAt])
}

model ExpenseCategory {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  slug       String
  isSystem   Boolean   @default(false)
  isActive   Boolean   @default(true)
  sortOrder  Int       @default(0)
  expenses   Expense[]
  createdAt  DateTime  @default(now())
  @@unique([businessId, slug])
  @@index([businessId, isActive])
}

model Expense {
  id              String    @id @default(cuid())
  businessId      String
  business        Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  subscriptionId  String?   @map("vendorId")
  subscription    Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  categoryId      String
  category        ExpenseCategory @relation(fields: [categoryId], references: [id])
  createdByUserId String
  createdByUser   User      @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  description     String
  date            DateTime
  amount          Int
  currency        String    @default("INR")
  paymentMethod   String?
  reference       String?
  notes           String?
  attachments     ExpenseAttachment[]
  bulkImportId    String?
  bulkImport      BulkImport? @relation(fields: [bulkImportId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt
  @@index([businessId, date])
  @@index([businessId, categoryId])
  @@index([businessId, subscriptionId])
}

model ExpenseAttachment {
  id         String   @id @default(cuid())
  expenseId  String
  expense    Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  fileName   String
  fileUrl    String
  fileType   String
  fileSize   Int
  uploadedAt DateTime @default(now())
  @@index([expenseId])
}

model BulkImport {
  id            String   @id @default(cuid())
  businessId    String
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: SetNull)
  fileName      String
  rowCount      Int
  importedCount Int
  skippedCount  Int
  errorLog      Json?
  expenses      Expense[]
  importedAt    DateTime @default(now())
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

model Project {
  id             String        @id @default(cuid())
  businessId     String
  business       Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  clientId       String?
  client         Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  name           String
  description    String?
  status         ProjectStatus @default(ACTIVE)
  hourlyRate     Int?
  currency       String        @default("USD")
  budgetAmount   Int?
  budgetHours    Int?
  startDate      DateTime?
  endDate        DateTime?
  archivedAt     DateTime?
  timeEntries    TimeEntry[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now()) @updatedAt
  @@index([businessId, status])
  @@index([businessId, clientId])
}

model TimeEntry {
  id             String       @id @default(cuid())
  businessId     String
  business       Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  projectId      String
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  date           DateTime
  minutes        Int
  description    String
  billable       Boolean      @default(true)
  hourlyRate     Int?
  invoiceLineId  String?
  invoiceLine    InvoiceLine? @relation(fields: [invoiceLineId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt
  @@index([businessId, projectId, date])
  @@index([businessId, invoiceLineId])
  @@index([userId])
}

model Contact {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  clientId   String?
  client     Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  name       String
  email      String?
  phone      String?
  title      String?
  notes      String?
  archivedAt DateTime?
  deals      Deal[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  @@index([businessId, clientId])
  @@index([businessId, archivedAt])
}

enum DealStage {
  LEAD
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

model Deal {
  id           String    @id @default(cuid())
  businessId   String
  business     Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  clientId     String?
  client       Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  contactId    String?
  contact      Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  title        String
  stage        DealStage @default(LEAD)
  value        Int?
  currency     String    @default("USD")
  probability  Int       @default(0)
  expectedAt   DateTime?
  closedAt     DateTime?
  notes        String?
  quotes       Quote[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt
  @@index([businessId, stage])
  @@index([businessId, clientId])
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

model Quote {
  id             String       @id @default(cuid())
  businessId     String
  business       Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id])
  dealId         String?
  deal           Deal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)
  number         String?
  issueDate      DateTime
  expiryDate     DateTime?
  currency       String
  status         QuoteStatus  @default(DRAFT)
  subtotal       Int
  discountAmount Int          @default(0)
  taxAmount      Int          @default(0)
  total          Int
  notes          String?
  terms          String?
  convertedInvoiceId String?
  lines          QuoteLine[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt
  @@unique([businessId, number])
  @@index([businessId, status])
  @@index([businessId, clientId])
}

model QuoteLine {
  id           String  @id @default(cuid())
  quoteId      String
  quote        Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId    String?
  description  String
  quantity     Int
  unitPrice    Int
  lineDiscount Int     @default(0)
  taxRate      Int     @default(0)
  lineTotal    Int
  sortOrder    Int
  @@index([quoteId])
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACTOR
  INTERN
}

enum EmployeeStatus {
  ACTIVE
  ONBOARDING
  ON_LEAVE
  TERMINATED
}

model Employee {
  id              String           @id @default(cuid())
  businessId      String
  business        Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  firstName       String
  lastName        String
  email           String
  phone           String?
  title           String?
  department      String?
  employmentType  EmploymentType   @default(FULL_TIME)
  status          EmployeeStatus   @default(ONBOARDING)
  startDate       DateTime
  endDate         DateTime?
  salaryAmount    Int?
  salaryCurrency  String           @default("USD")
  ptoBalanceDays  Int              @default(0)
  managerId       String?
  manager         Employee?        @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  reports         Employee[]       @relation("EmployeeManager")
  onboardingTasks OnboardingTask[]
  timeOffRequests TimeOffRequest[]
  documents       Document[]
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @default(now()) @updatedAt
  @@unique([businessId, email])
  @@index([businessId, status])
  @@index([businessId, managerId])
}

model OnboardingTask {
  id          String    @id @default(cuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  title       String
  description String?
  completedAt DateTime?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  @@index([employeeId])
}

enum TimeOffType {
  VACATION
  SICK
  PERSONAL
  UNPAID
  OTHER
}

enum TimeOffStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model TimeOffRequest {
  id          String         @id @default(cuid())
  businessId  String
  business    Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type        TimeOffType    @default(VACATION)
  startDate   DateTime
  endDate     DateTime
  days        Int
  reason      String?
  status      TimeOffStatus  @default(PENDING)
  decidedAt   DateTime?
  decidedById String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @default(now()) @updatedAt
  @@index([businessId, status])
  @@index([employeeId])
}

enum DocumentCategory {
  CONTRACT
  POLICY
  TAX
  ID
  OTHER
}

model Document {
  id             String           @id @default(cuid())
  businessId     String
  business       Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employeeId     String?
  employee       Employee?        @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  uploadedById   String?
  uploadedBy     User?            @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  title          String
  category       DocumentCategory @default(OTHER)
  fileName       String
  fileUrl        String
  fileType       String
  fileSize       Int
  notes          String?
  createdAt      DateTime         @default(now())
  @@index([businessId, employeeId])
  @@index([businessId, category])
}
