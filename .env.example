# PostgreSQL. With the included Docker Compose service, both URLs are identical.
DATABASE_URL="postgresql://invoicer:invoicer@localhost:5435/invoicer"
DIRECT_URL="postgresql://invoicer:invoicer@localhost:5435/invoicer"

# Supabase Auth and Storage. Never expose SUPABASE_SECRET_KEY to the browser.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
SUPABASE_SECRET_KEY="your-secret-key"

# Optional seed data. Required only when running `npm run db:seed`.
SEED_EMAIL="owner@example.com"
SEED_NAME="Demo Owner"
SEED_BUSINESS_NAME="Demo Business"

# Optional integrations. Invoice email delivery needs all three email/blob values.
RESEND_API_KEY="re_your_api_key"
RESEND_FROM="Invoicer <invoices@example.com>"
BLOB_READ_WRITE_TOKEN="vercel_blob_your_token"

# Required when enabling the recurring-invoice cron endpoint.
CRON_SECRET="replace-with-a-long-random-value"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
